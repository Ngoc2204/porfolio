# Optional — only needed when NEXT_PUBLIC_CONTACT_MODE=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Default: opens an email draft. Set to resend only after configuring Resend.
NEXT_PUBLIC_CONTACT_MODE=mailto

# Optional — your public origin. On Vercel, the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=

# Optional — WebSocket server URL for realtime features (live cursors, chat, presence)
# Leave empty to disable realtime features entirely
NEXT_PUBLIC_WS_URL=

# Optional — persistent visitor/online/like counters (Upstash Redis REST).
# Add these values in Vercel Project Settings → Environment Variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional — use a private random value to HMAC-hash visitor IPs.
# If unset, the Redis token is used as the HMAC secret.
PORTFOLIO_STATS_IP_SECRET=

# Optional — Umami analytics. Nothing loads unless UMAMI_SITE_ID is set.
# UMAMI_DOMAIN overrides the default script URL — set it if you self-host.
UMAMI_DOMAIN=
UMAMI_SITE_ID=

# Optional — Umami website id that /api/collect records deploy hostnames into.
# Unset = the endpoint only writes to the runtime log.
UMAMI_DEPLOY_SITE_ID=

# Optional — old domain you moved away from (e.g. example.site).
# When set, shows a one-time dismissible "we moved" notice. Leave empty.
NEXT_PUBLIC_LEGACY_HOST=
